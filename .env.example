# Copy to .env and adjust.
# Chain 31337 + deploy:local → token is usually at the default address below.

# --- Blockchain ---
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
ZYNC_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# --- App ---
PORT=3000

# --- Swap execution ---
# Set these to the router and WETH addresses for your local or test deployment.
SWAP_ROUTER_ADDRESS=
WETH_ADDRESS=
# Optional: quote expiry window in seconds
SWAP_DEADLINE_SECS=600
